#!/usr/bin/env python3
"""Render header.svg: a dot-lattice self-portrait on the left and a terminal on the
right where a coding agent introduces me and reports live GitHub numbers.

Numbers come from the GitHub GraphQL contributions collection plus the REST
contributor stats of every owned repository. A token is required; it is read
from ACCESS_TOKEN, GITHUB_TOKEN or `gh auth token`, in that order.

    bin/render            # writes header.svg
    bin/render --offline  # skip the API, keep placeholder numbers
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
import urllib.request
from datetime import date, timedelta
from pathlib import Path

USER = os.environ.get("USER_NAME", "YuukiFST")
OUT = Path(__file__).resolve().parent.parent / "header.svg"

ROOT = Path(__file__).resolve().parent.parent
PORTRAIT = ROOT / "assets" / "portrait.txt"  # '#' bright dot, '.' dim dot, from a photo

W, H = 1000, 600
SIDEBAR = 360  # portrait panel width
CYCLE = 24.0  # seconds per loop
CH = 8.4  # advance per glyph at font-size 14 in the monospace stack above

BG, PANE, LINE, TXT, DIM, KEY, ACC, OK, WARN, SEL = (
    "#000000", "#050505", "#171717", "#d4d4d4", "#3a3a3a", "#6a6a6a", "#b48cff", "#7dd3a0", "#f0b86e", "#141021",
)


# ---------------------------------------------------------------- data ------
def token() -> str:
    for name in ("ACCESS_TOKEN", "GITHUB_TOKEN"):
        if os.environ.get(name):
            return os.environ[name]
    out = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True)
    if out.returncode:
        sys.exit("no token: set ACCESS_TOKEN or run `gh auth login`")
    return out.stdout.strip()


def request(url: str, body: dict | None = None) -> tuple[int, object]:
    data = json.dumps(body).encode() if body else None
    req = urllib.request.Request(url, data=data, headers={"User-Agent": USER, "Authorization": f"Bearer {token()}"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.status, (json.load(r) if r.status != 204 else None)


QUERY = """
query($login:String!){ user(login:$login){ contributionsCollection{
  totalCommitContributions totalPullRequestContributions totalIssueContributions
  totalPullRequestReviewContributions restrictedContributionsCount
  contributionCalendar{ totalContributions weeks{ contributionDays{ date contributionCount } } }
  commitContributionsByRepository(maxRepositories:25){ repository{ name isPrivate } contributions{ totalCount } }
}}}"""


def streaks(days: list[dict]) -> tuple[int, int]:
    today = date.today()
    counts = {date.fromisoformat(d["date"]): d["contributionCount"] for d in days}
    current, best, run = 0, 0, 0
    for d in sorted(counts):
        run = run + 1 if counts[d] else 0
        best = max(best, run)
    d = today
    if not counts.get(d):
        d -= timedelta(days=1)  # today may still be empty; the streak is alive until midnight
    while counts.get(d):
        current += 1
        d -= timedelta(days=1)
    return current, best


def lines_changed() -> tuple[int, int]:
    """Sum additions/deletions authored by USER across owned repos. GitHub computes
    contributor stats lazily and answers 202 meanwhile, hence the retry."""
    _, repos = request(f"https://api.github.com/users/{USER}/repos?per_page=100&type=owner")
    added = removed = 0
    for repo in repos:
        if repo["fork"]:
            continue
        for _ in range(4):
            status, stats = request(f"https://api.github.com/repos/{USER}/{repo['name']}/stats/contributors")
            if status == 200 and stats:
                break
            time.sleep(3)
        else:
            continue
        for c in stats:
            if c["author"] and c["author"]["login"].lower() == USER.lower():
                added += sum(w["a"] for w in c["weeks"])
                removed += sum(w["d"] for w in c["weeks"])
    return added, removed


def stats() -> dict:
    if "--offline" in sys.argv:
        return {"contributions": 0, "commits": 0, "private": 0, "prs": 0, "issues": 0, "reviews": 0,
                "streak": 0, "longest": 0, "added": 0, "removed": 0, "repos": [("agent-dotfiles", 0)]}
    _, res = request("https://api.github.com/graphql", {"query": QUERY, "variables": {"login": USER}})
    c = res["data"]["user"]["contributionsCollection"]
    days = [d for w in c["contributionCalendar"]["weeks"] for d in w["contributionDays"]]
    current, best = streaks(days)
    added, removed = lines_changed()
    return {
        "contributions": c["contributionCalendar"]["totalContributions"],
        "commits": c["totalCommitContributions"],
        "private": c["restrictedContributionsCount"],
        "prs": c["totalPullRequestContributions"],
        "issues": c["totalIssueContributions"],
        "reviews": c["totalPullRequestReviewContributions"],
        "streak": current,
        "longest": best,
        "added": added,
        "removed": removed,
        # the token also sees private work; the sidebar only ever names public repos
        "repos": [(r["repository"]["name"], r["contributions"]["totalCount"])
                  for r in c["commitContributionsByRepository"] if not r["repository"]["isPrivate"]][:5],
    }


# --------------------------------------------------------------- scene ------
def pct(t: float) -> str:
    return f"{100 * t / CYCLE:.2f}%"


def esc(s: str) -> str:
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def n(v: int) -> str:
    return f"{v:,}"


class Scene:
    """Every animation shares one CYCLE so the loop restarts in sync."""

    def __init__(self) -> None:
        self.css: list[str] = []
        self.body: list[str] = []
        self.k = 0
        self.fade_at = CYCLE - 1.2

    def _id(self) -> str:
        self.k += 1
        return f"a{self.k}"

    def appear(self, at: float, svg: str) -> None:
        i = self._id()
        self.css.append(
            f"@keyframes {i}{{0%,{pct(at)}{{opacity:0}}{pct(at + .01)},{pct(self.fade_at)}{{opacity:1}}"
            f"{pct(self.fade_at + .6)},100%{{opacity:0}}}}.{i}{{animation:{i} {CYCLE}s linear infinite}}"
        )
        self.body.append(f'<g class="{i}">{svg}</g>')

    def typed(self, at: float, x: float, y: int, cmd: str, chars_per_s: float = 18) -> float:
        """Text revealed left to right, one glyph per step, with a block cursor and a
        glowing trail riding the typing edge. Returns finish time."""
        dur = len(cmd) / chars_per_s
        i = self._id()
        width = CH * len(cmd)
        end = at + dur
        # clip grows with the keystrokes; cursor and trail slide along the same track
        self.css.append(
            f"@keyframes {i}c{{0%,{pct(at)}{{width:0}}{pct(end)},100%{{width:{width}px}}}}"
            f".{i}c{{animation:{i}c {CYCLE}s steps({len(cmd)}) infinite}}"
            f"@keyframes {i}x{{0%,{pct(at)}{{transform:translateX(0)}}{pct(end)},100%{{transform:translateX({width}px)}}}}"
            f".{i}k{{animation:{i}x {CYCLE}s steps({len(cmd)}) infinite,{i}v {CYCLE}s steps(1) infinite}}"
            f".{i}t{{animation:{i}x {CYCLE}s linear infinite,{i}v {CYCLE}s steps(1) infinite}}"
            f"@keyframes {i}v{{0%,{pct(at)}{{opacity:1}}{pct(end + .15)},100%{{opacity:0}}}}"
        )
        self.body.append(
            f'<linearGradient id="{i}g"><stop offset="0" stop-color="{ACC}" stop-opacity="0"/>'
            f'<stop offset="1" stop-color="{ACC}" stop-opacity=".55"/></linearGradient>'
            f'<clipPath id="{i}p"><rect class="{i}c" x="{x}" y="{y - 16}" height="22"/></clipPath>'
        )
        self.appear(
            at,
            f'<g clip-path="url(#{i}p)"><text x="{x}" y="{y}" fill="{TXT}">{esc(cmd)}</text></g>'
            f'<rect class="{i}t" x="{x - 70}" y="{y - 13}" width="70" height="17" rx="2" fill="url(#{i}g)"/>'
            f'<rect class="{i}k" x="{x}" y="{y - 13}" width="{CH}" height="17" fill="{ACC}"/>',
        )
        return end


def row(y: float, cols: list[tuple]) -> str:
    """One line of text made of (x, text, color[, css class]) runs."""
    out = []
    for x, t, c, *cls in cols:
        klass = f' class="{cls[0]}"' if cls and cls[0] else ""
        out.append(f'<tspan x="{x:g}" fill="{c}"{klass}>{esc(t)}</tspan>')
    return f'<text y="{y:g}">' + "".join(out) + "</text>"


def runs(x: float, y: float, parts: list[tuple[str, str]]) -> str:
    """Inline colored runs on one line; tspans without x flow after each other, so the
    spacing holds whatever monospace font the viewer falls back to."""
    spans = "".join(f'<tspan fill="{color}">{esc(text)}</tspan>' for text, color in parts)
    return f'<text x="{x:g}" y="{y:g}">{spans}</text>'


# ------------------------------------------------------------ portrait ------
def portrait_rows() -> list[str]:
    """The dot map trimmed to its ink, so the face fills the panel instead of the dark hair above it."""
    rows = PORTRAIT.read_text(encoding="utf-8").splitlines()
    while rows and not rows[0].strip():
        rows.pop(0)
    while rows and not rows[-1].strip():
        rows.pop()
    left = min(len(r) - len(r.lstrip()) for r in rows if r.strip())
    return [r[left:] for r in rows]


def portrait() -> tuple[str, str]:
    """Returns (css, svg) for the left panel."""
    rows = portrait_rows()
    cols = max(map(len, rows))
    pad, top, bottom = 24, 60, 92
    # tall lattice cells (19 x 36 in the source engine) keep the photo's proportions
    cw = min((SIDEBAR - 2 * pad) / cols, (H - top - bottom) / len(rows) * 19 / 36)
    chh = cw * 36 / 19
    ox = (SIDEBAR - cw * cols) / 2
    oy = top + (H - top - bottom - chh * len(rows)) / 2
    big, dim, drop = cw * .36, cw * .16, chh * .19
    dots = []
    for j, r in enumerate(rows):
        for i, c in enumerate(r):
            if c in "#.":
                x, y = ox + (i + .5) * cw, oy + (j + .5) * chh + (drop if c == "." else 0)
                fill, rad = ("#f2f2f0", big) if c == "#" else ("#70706e", dim)
                dots.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="{rad:.2f}" fill="{fill}"/>')
    span = chh * len(rows)
    # a scanline sweeps down the portrait, then rests off-screen until the next pass
    css = (f"@keyframes scan{{0%{{transform:translateY(0);opacity:0}}5%{{opacity:1}}45%{{transform:translateY({span:.0f}px);opacity:1}}"
           f"50%,100%{{transform:translateY({span:.0f}px);opacity:0}}}}.scan{{animation:scan 8s ease-in-out infinite}}")
    scan = (
        f'<linearGradient id="scan" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="{ACC}" stop-opacity="0"/>'
        f'<stop offset="1" stop-color="{ACC}" stop-opacity=".3"/></linearGradient>'
        f'<g class="scan"><rect x="0" y="{oy - 40:.0f}" width="{SIDEBAR}" height="40" fill="url(#scan)"/>'
        f'<rect x="0" y="{oy:.0f}" width="{SIDEBAR}" height="1" fill="{ACC}" opacity=".7"/></g>'
    )
    label = (
        f'<text x="20" y="34" fill="{KEY}" font-size="12">~/portrait.dots</text>'
        f'<text x="{SIDEBAR - 20}" y="34" text-anchor="end" fill="{DIM}" font-size="12">{cols}x{len(rows)}</text>'
        f'<text x="20" y="{H - 50}" fill="{TXT}" font-size="22" font-weight="bold">Yuuki</text>'
        f'<text x="20" y="{H - 26}" fill="{KEY}" font-size="13">fullstack developer'
        f'<tspan fill="{ACC}"> · </tspan>go<tspan fill="{ACC}"> · </tspan>agents</text>'
    )
    panel = f'<rect width="{SIDEBAR}" height="{H}" fill="{BG}"/><rect x="{SIDEBAR}" width="1" height="{H}" fill="{LINE}"/>'
    return css, panel + f'<g>{"".join(dots)}</g>' + scan + label


# -------------------------------------------------------------- layout ------
def build(s: dict) -> str:
    sc = Scene()
    x0 = SIDEBAR + 34
    chrome = (
        f'<rect x="{SIDEBAR + 1}" width="{W - SIDEBAR - 1}" height="{H}" fill="{PANE}"/>'
        f'<rect x="{SIDEBAR + 1}" y="0" width="{W - SIDEBAR - 1}" height="34" fill="{BG}"/>'
        f'<rect x="{SIDEBAR + 1}" y="34" width="{W - SIDEBAR - 1}" height="1" fill="{LINE}"/>'
        + "".join(f'<circle cx="{SIDEBAR + 22 + 18 * i}" cy="17" r="5" fill="{c}"/>' for i, c in enumerate((DIM, DIM, ACC)))
        + f'<text x="{W - 16}" y="22" text-anchor="end" fill="{DIM}" font-size="12">yuuki@dev: ~</text>'
    )

    y = 68
    sc.body.append(f'<rect x="{SIDEBAR + 10}" y="{y - 17}" width="{W - SIDEBAR - 20}" height="24" rx="3" fill="{SEL}"/>')
    sc.body.append(f'<text x="{SIDEBAR + 18}" y="{y}" fill="{ACC}">❯</text>')
    t = sc.typed(0.5, x0, y, "who are you?")

    y += 40
    t += 0.5
    bio = [
        [("Hi, I'm Yuuki, a ", TXT), ("fullstack developer", ACC), (".", TXT)],
        [("I build things end to end, from the database to the UI.", TXT)],
        [("Favorite language: ", TXT), ("Go", OK), (". These days I study", TXT)],
        [("AI agents", ACC), (" and ", TXT), ("LLMs", ACC), (": how models reason and use tools.", TXT)],
    ]
    sc.appear(t, row(y, [(x0 - 12, "●", TXT)]) + "".join(runs(x0 + 6, y + 20 * k, line) for k, line in enumerate(bio)))

    y += 104
    t += 0.7
    sc.appear(t, row(y, [(x0 - 12, "●", TXT), (x0 + 6, "Bash", TXT), (x0 + 46, "(cat ~/.config/yuuki/stack.toml)", DIM)]))
    stack = [
        ("love", '["go"]'),
        ("use", '["typescript", "react", "nextjs"]'),
        ("study", '["agents", "llms", "langgraph"]'),
        ("know", '["python", "fastapi", "xgboost", "shap"]'),
    ]
    for k, v in stack:
        y += 22
        t += 0.2
        sc.appear(t, row(y, [(x0 + 6, "⎿", DIM), (x0 + 24, k, KEY), (x0 + 84, "= " + v, "#c9b8ff")]))

    y += 38
    t += 0.6
    sc.appear(t, row(y, [(x0 - 12, "●", TXT), (x0 + 6, "Bash", TXT), (x0 + 46, "(gh api graphql · last 365 days)", DIM)]))
    grid = [
        ("contributions", n(s["contributions"]), ACC, "commits", n(s["commits"]), ACC),
        ("pull requests", n(s["prs"]), ACC, "reviews", n(s["reviews"]), ACC),
        ("issues", n(s["issues"]), ACC, "private", n(s["private"]), ACC),
        ("lines added", "+" + n(s["added"]), OK, "lines removed", "-" + n(s["removed"]), WARN),
        ("streak", f"{s['streak']}d", ACC, "best streak", f"{s['longest']}d", ACC),
    ]
    for k1, v1, c1, k2, v2, c2 in grid:
        y += 22
        t += 0.25
        sc.appear(t, row(y, [(x0 + 6, "⎿", DIM), (x0 + 24, k1, KEY), (x0 + 150, v1, c1), (x0 + 290, k2, KEY), (x0 + 416, v2, c2)]))

    y += 38
    t += 0.8
    sc.appear(t, row(y, [(x0 - 12, "✳", ACC), (x0 + 6, f"updated {date.today():%Y-%m-%d} · refreshes daily", DIM)]))

    ib = H - 62
    sc.css.append("@keyframes blink{50%{opacity:0}}.cur{animation:blink 1s steps(1) infinite}")
    footer = (
        f'<rect x="{SIDEBAR + 1}" y="{ib - 1}" width="{W - SIDEBAR - 1}" height="1" fill="{LINE}"/>'
        f'<text x="{SIDEBAR + 18}" y="{ib + 22}" fill="{ACC}">❯</text><text x="{SIDEBAR + 34}" y="{ib + 22}" class="cur" fill="{ACC}">▍</text>'
        f'<text y="{H - 14}" font-size="12"><tspan x="{SIDEBAR + 18}" fill="{OK}">[GO]</tspan><tspan fill="{KEY}"> fullstack · </tspan>'
        f'<tspan fill="{TXT}">agents &amp; llms</tspan><tspan fill="{DIM}">  github.com/{USER}</tspan></text>'
    )
    pcss, pbody = portrait()

    return f"""<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}" font-family="JetBrains Mono,Fira Code,Cascadia Code,SF Mono,Menlo,Consolas,monospace" font-size="14" fill="{TXT}">
<style>text{{white-space:pre}}{pcss}{''.join(sc.css)}</style>
<clipPath id="win"><rect width="{W}" height="{H}" rx="12"/></clipPath>
<g clip-path="url(#win)">
<rect width="{W}" height="{H}" fill="{BG}"/>
{pbody}
{chrome}
{''.join(sc.body)}
{footer}
</g>
<rect x=".5" y=".5" width="{W - 1}" height="{H - 1}" rx="12" fill="none" stroke="{LINE}"/>
</svg>
"""


if __name__ == "__main__":
    OUT.write_text(build(stats()), encoding="utf-8", newline="\n")
    print(f"wrote {OUT}")
