#!/usr/bin/env bash
#
# Refreshes everything the profile shows and publishes it.
#
#   bin/update              rebuild, commit and push
#   bin/update --no-push    rebuild and commit, stay local
#   bin/update --no-commit  rebuild only, leave the working tree dirty
#
# Nothing here updates on its own: GitHub serves dark_mode.svg and
# light_mode.svg straight from main, so the numbers only move when this runs.
set -euo pipefail

cd "$(dirname "$0")/.."

commit=1
push=1
for argument in "$@"; do
  case "$argument" in
    --no-push) push=0 ;;
    --no-commit) commit=0; push=0 ;;
    -h|--help) sed -n '2,10p' "$0" | cut -c3-; exit 0 ;;
    *) echo "unknown option: $argument" >&2; exit 2 ;;
  esac
done

python=$(command -v python3 || command -v python) || {
  echo "python is not on PATH" >&2; exit 1
}

# The token is only ever read from the environment or from the gh session; it is
# never written to a file in this repository.
if [ -z "${ACCESS_TOKEN:-}" ]; then
  command -v gh >/dev/null || {
    echo "set ACCESS_TOKEN, or install gh and run: gh auth login" >&2; exit 1
  }
  ACCESS_TOKEN="$(gh auth token)"
fi
export ACCESS_TOKEN
export USER_NAME="${USER_NAME:-YuukiFST}"

echo "==> rebuilding the template"
"$python" scripts/build_svg_template.py

echo "==> pulling GitHub stats, the contribution calendar and the gitfut card"
"$python" today.py

if git diff --quiet -- dark_mode.svg light_mode.svg; then
  echo "==> nothing moved since the last run"
  exit 0
fi

if [ "$commit" -eq 0 ]; then
  echo "==> rebuilt; commit skipped"
  git --no-pager diff --stat -- dark_mode.svg light_mode.svg
  exit 0
fi

git add dark_mode.svg light_mode.svg
git commit -m "chore(profile): refresh stats, calendar and card"

if [ "$push" -eq 1 ]; then
  git push origin "$(git rev-parse --abbrev-ref HEAD)"
  echo "==> published"
else
  echo "==> committed locally; push when you want it live"
fi
